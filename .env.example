# API Claude (Anthropic) — necessário para funcionalidades de IA
ANTHROPIC_API_KEY=sk-ant-api03-SUA_CHAVE_AQUI

# Google Sheets — Torre de Comando (leitura)
GOOGLE_SHEETS_ID=SEU_SPREADSHEET_ID_AQUI
