# ============================================================================
# Segundo Cérebro — Variáveis de Ambiente (VPS / EasyPanel)
# ============================================================================
# Configure estas variáveis no EasyPanel (aba "Environment")
# Ou copie este arquivo para .env no servidor
# ============================================================================

# API Claude (Anthropic) — necessário para funcionalidades de IA
ANTHROPIC_API_KEY=sk-ant-api03-SUA_CHAVE_AQUI

# Google Sheets — Torre de Comando (leitura)
GOOGLE_SHEETS_ID=SEU_SPREADSHEET_ID_AQUI
GOOGLE_API_KEY=SUA_GOOGLE_API_KEY_AQUI

# Porta do servidor (EasyPanel geralmente usa 3000 ou 80)
PORT=3000

# Ambiente
NODE_ENV=production
