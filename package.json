{
  "name": "segundo-cerebro",
  "version": "1.0.0",
  "description": "Gerenciador de Tarefas com Memória de Contexto - Segundo Cérebro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.js",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.segundocerebro.app",
    "productName": "Segundo Cérebro",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "ai-bridge.js",
      "ai-service.js",
      "google-sheets-service.js",
      "icon.png",
      ".env"
    ]
  },
  "keywords": [
    "task-manager",
    "brain",
    "knowledge-base"
  ],
  "author": "Pedro",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "googleapis": "^171.4.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}